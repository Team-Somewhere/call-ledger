{
  "name": "call-ledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=@call-ledger/database",
    "db:migrate": "npm run db:migrate --workspace=@call-ledger/database",
    "db:push": "npm run db:push --workspace=@call-ledger/database",
    "db:studio": "npm run db:studio --workspace=@call-ledger/database"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.9.0"
    }
  }
}
