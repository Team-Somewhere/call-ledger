{
  "name": "@call-ledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./source-adapters": "./src/integrations/sources/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./src/tests/setup-env.ts --test src/tests/*.test.ts",
    "test:unit": "node --import tsx --test src/tests/order-flow.test.ts src/tests/wallet-auth.test.ts src/tests/crypto.test.ts src/tests/qualification.test.ts src/tests/x-client.test.ts"
  },
  "dependencies": {
    "@call-ledger/arkiv": "*",
    "@call-ledger/database": "*",
    "@call-ledger/definitive": "*",
    "@call-ledger/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "rss-parser": "^3.13.0",
    "viem": "^2.57.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "26.4.1",
    "tsx": "^4.19.3",
    "typescript": "7.0.2"
  }
}
