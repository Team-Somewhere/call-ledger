# Application
NODE_ENV=development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
API_PORT=8000
API_CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL / Neon connection string)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Phase 2A — Multi-source creator integration
# ---------------------------------------------------------------------------

# Optional Firecrawl integration for AUTHORIZED website sources only.
# Leave empty / disabled and the rest of the application works normally.
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_MAX_PAGES_PER_RUN=5
FIRECRAWL_MAX_RESPONSE_BYTES=2097152
# Optional override (defaults to https://api.firecrawl.dev)
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# X ingestion is DISABLED by default. Do not enable without an authorized
# X data provider. CallLedger never scrapes X, never uses undocumented
# endpoints, and never collects session cookies.
X_INGESTION_ENABLED=false

# Wallet authentication
# Lifetime of a single-use login nonce, in milliseconds (default 5 minutes).
WALLET_NONCE_TTL_MS=300000
# HMAC secret used to sign wallet session tokens. Use a long random value.
# e.g. openssl rand -base64 48
SESSION_SECRET=
# Comma-separated wallet addresses granted admin privileges (lowercase).
ADMIN_WALLET_ADDRESSES=

# X API Integration (Phase 2)
# Obtain from X Developer Portal (https://developer.x.com/en/portal/dashboard)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:8000/api/integrations/x/callback
X_BEARER_TOKEN=

# Server-Side OAuth Encryption Secret (32+ character random string)
# e.g., openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=

# Legacy X-only polling settings (not used by the Phase 2B source worker)
CREATOR_POLLING_ENABLED=true
CREATOR_POLLING_INTERVAL_MS=15000
CREATOR_POLLING_MAX_CONCURRENCY=3

# Phase 2B — global creator-source polling worker
MONITORING_WORKER_ENABLED=true
MONITORING_WORKER_INTERVAL_MS=5000
MONITORING_WORKER_BATCH_SIZE=10
MONITORING_LOCK_LEASE_SECONDS=300
MONITORING_POLL_INTERVAL_RSS_SECONDS=900
MONITORING_POLL_INTERVAL_BLUESKY_SECONDS=600
MONITORING_POLL_INTERVAL_WEBSITE_SECONDS=3600
MONITORING_DEFAULT_POST_LIMIT=20
MONITORING_INITIAL_POST_LIMIT=20
MONITORING_MAX_RETRIES=3
MONITORING_POLL_JITTER_SECONDS=60
MONITORING_REQUEST_TIMEOUT_MS=20000
MONITORING_MAX_RESPONSE_BYTES=2097152

# X Developer Policy Content Retention Mode:
# 'store' - store tweet text with deletion synchronization compliance
# 'id_only' - do not store raw tweet text; IDs and public metadata only
X_CONTENT_RETENTION_MODE=store

# Future integrations — not used in Phase 2
OPENROUTER_API_KEY=
DEFINITIVE_API_KEY=

# ---------------------------------------------------------------------------
# Phase 3 — Arkiv Rabdi testnet archive
# ---------------------------------------------------------------------------

# Arkiv Rabdi testnet configuration
# Access key from hub.arkiv.network/access-keys (safe to use in backend only)
ARKIV_ACCESS_KEY=
# Optional: override the default Rabdi RPC URL
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Private key for the dedicated archive wallet (hex, 0x-prefixed)
# Fund this address with testnet tGLM from hub.arkiv.network/faucet
# NEVER commit this value. NEVER expose it to the frontend.
ARKIV_ARCHIVER_PRIVATE_KEY=
# How many days before an archived entity expires (default 365)
ARKIV_POST_EXPIRY_DAYS=365

# X Monitoring budget controls
# Set X_MONITOR_ENABLED=true when FIRECRAWL_API_KEY is set and you accept credit costs.
X_MONITOR_ENABLED=false
# Minutes between polls per trader (default 30)
X_MONITOR_DEFAULT_INTERVAL_MINUTES=30
# Max traders processed per worker cycle (cost control)
X_MONITOR_MAX_TRADERS_PER_CYCLE=5
# Max Firecrawl search requests per day (hard stop when reached)
X_MONITOR_MAX_REQUESTS_PER_DAY=10
# Estimated Firecrawl credits consumed per request (informational)
X_MONITOR_ESTIMATED_CREDITS_PER_REQUEST=30
